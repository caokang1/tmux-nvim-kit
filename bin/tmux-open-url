#!/usr/bin/env bash
# tmux 前缀+u：列出当前面板里最近出现的链接，选中后用 win-open 在浏览器中打开
#   tmux-open-url <面板> <客户端>    弹出菜单
#   tmux-open-url --open <序号>      打开菜单里的第几个
LIST="${TMPDIR:-/tmp}/tmux-open-url-$(id -u)"
OPEN="$(dirname "$(readlink -f "$0")")/win-open"

if [ "$1" = --open ]; then
  url=$(sed -n "${2}p" "$LIST")
  [ -n "$url" ] && "$OPEN" "$url"
  exit 0
fi

# -J 把折行的长链接拼回一行；取最近 3000 行，最新的排前面，去重后最多 9 个
tmux capture-pane -J -p -S -3000 -t "$1" |
  grep -oE 'https?://[^][:space:]"<>`'"'"'|]+' |
  sed -E 's/[.,;:!?)）。，；：]+$//' |
  tac | awk '!seen[$0]++' | head -9 >"$LIST"

if [ ! -s "$LIST" ]; then
  tmux display -c "$2" -d 2000 '当前面板里没有找到链接'
  exit 0
fi

args=()
i=1
while IFS= read -r url; do
  label=$url
  [ ${#label} -gt 80 ] && label="${label:0:77}..."
  args+=("${label//#/##}" "$i" "run-shell -b '$0 --open $i'")
  i=$((i + 1))
done <"$LIST"
tmux display-menu -c "$2" -t "$1" -T '#[align=centre] 打开链接（最新在上，回车或数字键选择） ' "${args[@]}"
